# Your receiving wallet address on Base (mainnet) - NOT the same wallet used to pay/test
RECEIVER_ADDRESS=0xYourReceiverWalletAddress

# Price per call, e.g. "$0.02"
PRICE_USD=$0.02

# "base" for mainnet, "base-sepolia" for testnet
X402_NETWORK=base

# CDP mainnet facilitator (set once you have CDP API keys); leave default for the public facilitator
FACILITATOR_URL=https://x402.org/facilitator

# Only needed if using the CDP mainnet facilitator directly
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
